NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
REALTIME_HOST=127.0.0.1
REALTIME_PORT=4001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# Set to the exact count of trusted reverse-proxy hops in deployment; leave unset for direct/local access.
# API_TRUST_PROXY_HOPS=1
# MONGODB_URI=mongodb://127.0.0.1:27017/workspace
# Optional in local development; required in production. Generate 32 random bytes as 64 hex chars; never commit a real key.
# IDENTITY_RATE_LIMIT_KEY=
# Optional shared sender for sign-in verification mail only. Requires Gmail 2-Step Verification and an App Password.
# Session owners connect their own Gmail in Whiteboard to send invitations from their account.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# Per-user invitation sender: create a Google OAuth Web application client.
# Set its authorized redirect URI to exactly the value below; add local/LAN variants if needed.
# Request only the Gmail send scope; each owner must consent to connect their own account.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google-mail/callback
# Generate 32 random bytes and encode as 64 hex characters; used to encrypt OAuth refresh tokens in MongoDB.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
