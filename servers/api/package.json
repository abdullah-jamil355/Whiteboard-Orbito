{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test features/health/tests/*.test.ts features/identity/tests/*.test.ts features/sessions/tests/*.test.ts features/invitations/tests/*.test.ts features/realtime/tests/*.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/mongodb.test.ts tests/shutdown.test.ts",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.0",
    "@workspace/logging": "workspace:*",
    "@workspace/types": "workspace:*",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.1.7",
    "yjs": "13.6.27",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
