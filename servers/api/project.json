{
  "name": "api",
  "type": "server",
  "description": "Primary Express API runtime.",
  "internalDependencies": ["eslint-config", "logging", "tsconfig", "types"],
  "externalDependencies": ["@hocuspocus/server", "dotenv", "express", "mongoose", "nodemailer", "yjs", "zod"],
  "capabilities": ["http-api", "health", "mongodb-integration", "whiteboard-identity", "whiteboard-sessions", "whiteboard-invitations", "whiteboard-realtime"],
  "tasks": {
    "dev": { "command": "pnpm run dev", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "IDENTITY_RATE_LIMIT_KEY", "API_TRUST_PROXY_HOPS", "REALTIME_HOST", "REALTIME_PORT", "GMAIL_USER", "GMAIL_APP_PASSWORD", "BREVO_API_KEY", "BREVO_SENDER_EMAIL", "GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "GOOGLE_OAUTH_REDIRECT_URI", "GOOGLE_TOKEN_ENCRYPTION_KEY"], "cache": false },
    "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}
